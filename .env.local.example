# ── Supabase (obrigatório) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX

# Secret key — Project Settings → API Keys → Secret keys → "default"
# Revele e copie o valor completo sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXX

# ── Cloudflare R2 (opcional — só pra tela "Grupos de Imagens") ─
# Credencial de infraestrutura compartilhada da equipe (ver manual da TI),
# não um login pessoal — por isso fica aqui, nunca digitada numa tela.
# Confirme a grafia exata de R2_PUBLIC_BASE_URL com a TI antes de preencher
# (o manual tem duas grafias diferentes pro mesmo domínio).
R2_ACCOUNT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
R2_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
R2_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
R2_BUCKET=images-msm
R2_PUBLIC_BASE_URL=https://images-msm.vmisecurity.com
# R2_BASE_PREFIX=img/Monte sua Máquina/Imagens - MSM/
