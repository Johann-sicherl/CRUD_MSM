# Copie este arquivo para .env.local e preencha com seus dados do Supabase
# Project Settings → Database → Connection string

DATABASE_HOST=db.XXXXXXXXXX.supabase.co
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=SUA_SENHA_DO_SUPABASE
DATABASE_SSL=true

# Supabase JS Client (opcional — para auth/realtime no futuro)
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXX
